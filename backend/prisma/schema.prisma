// ============================================================================
// CAPH-CI — Module OPH — Schéma de données (PostgreSQL)
// Conventions : clés uuid, createdAt/updatedAt, archivage logique (archivedAt).
// Les dossiers d'adhésion, décisions et journaux ne sont JAMAIS supprimés.
// Les e-mails sont stockés en minuscules (normalisation faite par les services).
// ============================================================================

generator client {
  provider   = "prisma-client-js"
  // Client « sans moteur Rust » : requêtes exécutées par l'adaptateur PostgreSQL (@prisma/adapter-pg).
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── ENUMS ────────────────────────────────────

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum ContactPreference {
  EMAIL
  PHONE
}

enum RoleScope {
  GLOBAL // personnel CAPH-CI
  ORGANIZATION // rôle au sein d'une OPH
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OneTimeTokenType {
  INVITATION
  PASSWORD_RESET
}

enum MembershipRequestType {
  FIRST
  RENEWAL
}

enum MembershipStatus {
  DRAFT
  SUBMITTED
  TO_COMPLETE
  UNDER_REVIEW
  ADMITTED_PAYMENT_PENDING
  ADJOURNED
  REJECTED
  REGISTERED
  WITHDRAWN
}

enum DocumentReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum DecisionOutcome {
  ADMITTED
  ADJOURNED
  REJECTED
}

enum DecisionBody {
  BOARD // Conseil d'Administration
  GENERAL_ASSEMBLY // Assemblée Générale (membres honoraires)
}

enum ActorType {
  APPLICANT
  STAFF
  SYSTEM
}

enum PaymentMethod {
  CASH
  MOBILE_MONEY
  BANK_TRANSFER
  OTHER
}

enum FeePeriodicity {
  ONE_TIME
  MONTHLY
  YEARLY
}

enum CategorieDocument {
  GUIDE
  FORM
  MEETING_MINUTES
  REFERENCE
  OTHER
}

enum DocumentAccessLevel {
  MEMBERS // tous les membres d'une OPH
  CONTRIBUTORS // Président et Contributeurs uniquement
}

enum OpportunityType {
  CALL_FOR_PROJECTS
  TRAINING
  CONSULTATION
  JOB
  INTERNSHIP
  GRANT
  OTHER
}

enum OpportunityStatus {
  OPEN
  CLOSED
  ENDED
}

/// Validation par le personnel CAPH-CI des contenus proposés par une OPH (documents, opportunités, événements).
enum ContentReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Visibility {
  PUBLIC
  MEMBERS
}

enum CommunicationKind {
  INTERNAL
  EXTERNAL
}

enum TypeEvenement {
  MEETING
  TRAINING
  GENERAL_ASSEMBLY
  CONFERENCE
  FORUM
  CAMPAIGN
  CEREMONY
}

enum ModeEvenement {
  ONLINE
  ONSITE
  HYBRID
}

enum StatutEvenement {
  PLANNED
  OPEN
  REGISTRATION
  CLOSED
  CANCELLED
}

enum TypeRapport {
  ACTIVITY
  FINANCIAL
  OTHER
}

enum StatutRapport {
  RECEIVED
  IN_PROCESS
  PROCESSED
  CORRECTION_REQUESTED
}

enum NewsStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  CORRECTION
  APPROVED
  REJECTED
  PUBLISHED
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  TO_COMPLETE
  VALIDATED
  REJECTED
  ONGOING
  COMPLETED
}

// ───────────────────────────── RÉFÉRENTIELS ───────────────────────────────

model Region {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  name          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  delegations   Delegation[]
  organizations Organization[]
  evenements        Evenement[]

  @@map("regions")
}

model Delegation {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @unique
  regionId           String?             @db.Uuid @map("region_id")
  region             Region?             @relation(fields: [regionId], references: [id])
  commune            String?
  email              String?
  phone              String?
  archivedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organizations      Organization[]
  userRoles          UserRole[]
  membershipRequests MembershipRequest[]
  communications     Communication[]

  @@index([regionId])
  @@map("delegations")
}

model DomaineIntervention {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  label         String
  sortOrder     Int            @default(0)
  organizations Organization[]

  @@map("domaines_intervention")
}

model TypeHandicap {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  label         String
  sortOrder     Int            @default(0)
  organizations Organization[]

  @@map("types_handicap")
}

model NewsCategory {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique
  label         String
  sortOrder     Int            @default(0)
  newsProposals NewsProposal[]

  @@map("categories_actualites")
}

// ─────────────────────────── COMPTES ET ACCÈS ─────────────────────────────

model User {
  id                String            @id @default(uuid()) @db.Uuid
  email             String            @unique
  passwordHash      String? // null tant que l'invitation n'est pas acceptée
  firstName         String
  lastName          String
  phone             String?
  jobTitle          String?
  avatarKey         String?
  status            UserStatus        @default(INVITED)
  contactPreference ContactPreference @default(EMAIL)
  failedLoginCount  Int               @default(0)
  lockedUntil       DateTime?
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  roles              UserRole[]
  membership         OrganizationMember?
  refreshTokens      RefreshToken[]
  oneTimeTokens      OneTimeToken[]
  communicationReads CommunicationRead[]
  auditLogs          AuditLog[]
  decisionsRecorded  MembershipDecision[] @relation("DecisionRecorder")
  paymentsRecorded   PaymentRecord[]      @relation("PaymentRecorder")
  documentsReviewed  MembershipDocument[] @relation("DocumentReviewer")
  rapportsAuthored    Rapport[]             @relation("RapportAuthor")
  rapportsReviewed    Rapport[]             @relation("RapportReviewer")
  newsAuthored       NewsProposal[]       @relation("NewsAuthor")
  newsReviewed       NewsProposal[]       @relation("NewsReviewer")
  projectsAuthored   Project[]            @relation("ProjectAuthor")
  projectsReviewed   Project[]            @relation("ProjectReviewer")

  @@index([status])
  @@map("utilisateurs")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model Role {
  id          String               @id @default(uuid()) @db.Uuid
  code        String               @unique
  label       String
  scope       RoleScope
  permissions RolePermission[]
  userRoles   UserRole[]
  members     OrganizationMember[]

  @@map("roles")
}

model RolePermission {
  roleId       String     @db.Uuid @map("role_id")
  permissionId String     @db.Uuid @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("roles_permissions")
}

// Rôles du personnel CAPH-CI. delegationId limite le rôle à une délégation.
model UserRole {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid @map("utilisateur_id")
  roleId       String      @db.Uuid @map("role_id")
  delegationId String?     @db.Uuid @map("delegation_id")
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role        @relation(fields: [roleId], references: [id])
  delegation   Delegation? @relation(fields: [delegationId], references: [id])

  @@index([userId])
  @@map("roles_utilisateurs")
}

// Appartenance d'un utilisateur à UNE seule OPH (userId unique).
model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @unique @db.Uuid @map("utilisateur_id")
  organizationId String       @db.Uuid @map("organisation_id")
  roleId         String       @db.Uuid @map("role_id")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
  role           Role         @relation(fields: [roleId], references: [id])

  @@index([organizationId])
  @@map("membres_organisation")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid @map("utilisateur_id")
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("jetons_actualisation")
}

// Jetons à usage unique (invitation, réinitialisation). Seul le hash est stocké.
model OneTimeToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid @map("utilisateur_id")
  type      OneTimeTokenType
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("jetons_usage_unique")
}

// ───────────────────────────── ORGANISATIONS ──────────────────────────────

model Organization {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String             @unique
  acronym              String?
  legalReference       String? // n° de récépissé / référence légale
  status               OrganizationStatus @default(ACTIVE)
  memberNumber         String?            @unique
  registeredAt         DateTime?
  delegationId         String?            @db.Uuid @map("delegation_id")
  regionId             String?            @db.Uuid @map("region_id")
  commune              String?
  address              String?
  postalAddress        String?
  phone                String?
  email                String? // e-mail de l'organisation (privé : connexion et notifications)
  website              String?
  interventionZone     String?
  // Annuaire : l'OPH n'apparaît que si isListed ET consentement enregistré.
  isListed             Boolean            @default(false)
  publicationConsentAt DateTime?
  // Visibilité champ par champ. Liste blanche : publicEmail, publicPhone, postalAddress, website
  fieldVisibility      Json               @default("{}")
  publicEmail          String?
  publicPhone          String?
  archivedAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  delegation        Delegation?          @relation(fields: [delegationId], references: [id])
  region            Region?              @relation(fields: [regionId], references: [id])
  domains           DomaineIntervention[]
  typesHandicap   TypeHandicap[]
  members           OrganizationMember[]
  membershipRequest MembershipRequest?
  rapports           Rapport[]
  newsProposals     NewsProposal[]
  projects          Project[]
  communications    Communication[]
  documents Document[]
  opportunities     Opportunity[]
  evenements            Evenement[]

  @@index([delegationId])
  @@index([regionId])
  @@index([isListed, status])
  @@map("organisations")
}

// ──────────────────────────────── ADHÉSION ────────────────────────────────

model MembershipCategory {
  id                String              @id @default(uuid()) @db.Uuid
  code              String              @unique
  label             String
  description       String?
  isActive          Boolean             @default(false)
  // [{ type, label, requirement: REQUIRED|RECOMMENDED|OPTIONAL|AFTER_ADMISSION }]
  requiredDocuments Json                @default("[]")
  sortOrder         Int                 @default(0)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  requests          MembershipRequest[]

  @@map("categories_adhesion")
}

// Barème des droits et cotisations (RI 2026, transitoire : modifiable).
model FeeSchedule {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @unique
  label       String
  amountFcfa  Int
  periodicity FeePeriodicity
  validFrom   DateTime       @default(now())
  validTo     DateTime?
  isActive    Boolean        @default(true)
  updatedAt   DateTime       @updatedAt

  @@map("baremes_cotisations")
}

// Compteur annuel pour générer CAPH-AAAA-NNNNNN sans doublon.
model ReferenceCounter {
  year Int @id
  last Int @default(0)

  @@map("compteurs_reference")
}

model FileAsset {
  id           String    @id @default(uuid()) @db.Uuid
  storageKey   String    @unique // nom aléatoire sur disque, jamais le nom d'origine
  originalName String
  mimeType     String
  sizeBytes    Int
  sha256       String
  encrypted    Boolean   @default(false)
  uploadedById String?   @db.Uuid @map("depose_par_id")
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  membershipDocuments MembershipDocument[]
  rapportPiecesJointes   RapportPieceJointe[]
  newsAttachments     NewsAttachment[]
  newsCovers          NewsProposal[]       @relation("NewsCover")
  projectCovers       Project[]            @relation("ProjectCover")
  projectAttachments  ProjectAttachment[]
  documents   Document[]
  opportunities       Opportunity[]

  @@map("fichiers")
}

model MembershipRequest {
  id                       String                @id @default(uuid()) @db.Uuid
  reference                String?               @unique // générée à la soumission
  categoryId               String                @db.Uuid @map("categorie_id")
  requestType              MembershipRequestType @default(FIRST)
  existingMemberNumber     String?
  status                   MembershipStatus      @default(DRAFT)
  applicantName            String
  applicantEmail           String
  applicantPhone           String?
  trackingTokenHash        String
  data                     Json                  @default("{}") // champs propres à la catégorie
  dataVersion              Int                   @default(1)
  delegationId             String?               @db.Uuid @map("delegation_id")
  delegationOverrideReason String?
  declarationsAcceptedAt   DateTime?
  declarationIp            String?
  signerName               String?
  publicationConsent       Boolean               @default(false)
  submittedAt              DateTime?
  lastActionAt             DateTime              @default(now())
  organizationId           String?               @unique @db.Uuid @map("organisation_id") // renseigné à l'enregistrement
  memberCardNumber         String?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  category     MembershipCategory   @relation(fields: [categoryId], references: [id])
  delegation   Delegation?          @relation(fields: [delegationId], references: [id])
  organization Organization?        @relation(fields: [organizationId], references: [id])
  documents    MembershipDocument[]
  events       MembershipEvent[]
  decisions    MembershipDecision[]
  payments     PaymentRecord[]

  @@index([status])
  @@index([categoryId])
  @@index([applicantEmail])
  @@index([delegationId])
  @@index([submittedAt])
  @@map("demandes_adhesion")
}

model MembershipDocument {
  id           String               @id @default(uuid()) @db.Uuid
  requestId    String               @db.Uuid @map("demande_id")
  type         String // ex. LEGAL_REGISTRATION, STATUTES, REPRESENTATIVE_ID
  fileId       String               @db.Uuid @map("fichier_id")
  status       DocumentReviewStatus @default(PENDING)
  reviewNote   String?
  reviewedById String?              @db.Uuid @map("valide_par_id")
  reviewedAt   DateTime?
  createdAt    DateTime             @default(now())
  deletedAt    DateTime?
  request      MembershipRequest    @relation(fields: [requestId], references: [id])
  file         FileAsset            @relation(fields: [fileId], references: [id])
  reviewedBy   User?                @relation("DocumentReviewer", fields: [reviewedById], references: [id])

  @@index([requestId])
  @@map("documents_adhesion")
}

// Historique append-only : on n'édite ni ne supprime jamais une ligne.
model MembershipEvent {
  id         String            @id @default(uuid()) @db.Uuid
  requestId  String            @db.Uuid @map("demande_id")
  actorType  ActorType
  actorId    String?           @db.Uuid @map("acteur_id")
  action     String // SUBMIT, REQUEST_INFO, DECISION, PAYMENT, REGISTER…
  fromStatus MembershipStatus?
  toStatus   MembershipStatus?
  comment    String?
  createdAt  DateTime          @default(now())
  request    MembershipRequest @relation(fields: [requestId], references: [id])

  @@index([requestId, createdAt])
  @@map("evenements_adhesion")
}

model MembershipDecision {
  id                String            @id @default(uuid()) @db.Uuid
  requestId         String            @db.Uuid @map("demande_id")
  outcome           DecisionOutcome
  body              DecisionBody
  decisionReference String
  decidedAt         DateTime
  motive            String? // obligatoire si ajourné ou refusé (contrôlé par le service)
  recordedById      String            @db.Uuid @map("enregistre_par_id")
  createdAt         DateTime          @default(now())
  request           MembershipRequest @relation(fields: [requestId], references: [id])
  recordedBy        User              @relation("DecisionRecorder", fields: [recordedById], references: [id])

  @@index([requestId])
  @@map("decisions_adhesion")
}

model PaymentRecord {
  id            String            @id @default(uuid()) @db.Uuid
  requestId     String            @db.Uuid @map("demande_id")
  lines         Json // [{ feeCode, label, amountFcfa }]
  totalFcfa     Int
  method        PaymentMethod
  receiptNumber String            @unique
  paidAt        DateTime
  recordedById  String            @db.Uuid @map("enregistre_par_id")
  createdAt     DateTime          @default(now())
  request       MembershipRequest @relation(fields: [requestId], references: [id])
  recordedBy    User              @relation("PaymentRecorder", fields: [recordedById], references: [id])

  @@index([requestId])
  @@map("paiements_adhesion")
}

// ─────────────────────────────── ESPACE MEMBRE ────────────────────────────

model Document {
  id          String                   @id @default(uuid()) @db.Uuid
  title       String
  description String?
  category    CategorieDocument
  accessLevel DocumentAccessLevel      @default(MEMBERS)
  fileId      String                   @db.Uuid @map("fichier_id")
  isFeatured  Boolean                  @default(false)
  publishedAt DateTime                 @default(now())
  archivedAt  DateTime?
  createdById String?                  @db.Uuid @map("cree_par_id")
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  file        FileAsset                @relation(fields: [fileId], references: [id])
  organizationId String?             @db.Uuid @map("organisation_id") // OPH auteur ; vide = publié par le personnel CAPH-CI
  reviewStatus   ContentReviewStatus @default(APPROVED)
  reviewedAt     DateTime?
  reviewedById   String?             @db.Uuid @map("valide_par_id")
  reviewNote     String? // motif en cas de refus
  organization   Organization?       @relation(fields: [organizationId], references: [id])

  @@index([category, publishedAt])
  @@index([organizationId, reviewStatus])
  @@map("documents")
}

model Opportunity {
  id          String            @id @default(uuid()) @db.Uuid
  reference   String            @unique // OP-AAAA-NN
  title       String
  summary     String
  body        String?
  type        OpportunityType
  status      OpportunityStatus @default(OPEN)
  deadline    DateTime?
  audience    String? // public concerné
  modality    String? // ex. dépôt en ligne
  visibility  Visibility        @default(MEMBERS)
  sheetFileId String?           @db.Uuid @map("fichier_fiche_id") // fiche à télécharger
  archivedAt  DateTime?
  createdById String?           @db.Uuid @map("cree_par_id")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  sheetFile   FileAsset?        @relation(fields: [sheetFileId], references: [id])
  organizationId String?             @db.Uuid @map("organisation_id") // OPH auteur ; vide = publié par le personnel CAPH-CI
  reviewStatus   ContentReviewStatus @default(APPROVED)
  reviewedAt     DateTime?
  reviewedById   String?             @db.Uuid @map("valide_par_id")
  reviewNote     String? // motif en cas de refus
  isDemo         Boolean             @default(false) // donnée de démonstration (jamais en production)
  organization   Organization?       @relation(fields: [organizationId], references: [id])

  @@index([organizationId, reviewStatus])
  @@index([status, deadline])
  @@index([visibility])
  @@map("opportunites")
}

model Communication {
  id            String              @id @default(uuid()) @db.Uuid
  kind          CommunicationKind   @default(INTERNAL)
  category      String?
  title         String
  body          String
  senderLabel   String              @default("Équipe CAPH-CI")
  audienceAll   Boolean             @default(true)
  delegations   Delegation[]
  organizations Organization[]
  publishedAt   DateTime            @default(now())
  archivedAt    DateTime?
  isDemo        Boolean             @default(false) // donnée de démonstration
  createdById   String?             @db.Uuid @map("cree_par_id")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  reads         CommunicationRead[]

  @@index([kind, publishedAt])
  @@map("communications")
}

model CommunicationRead {
  communicationId String        @db.Uuid @map("communication_id")
  userId          String        @db.Uuid @map("utilisateur_id")
  readAt          DateTime      @default(now())
  communication   Communication @relation(fields: [communicationId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([communicationId, userId])
  @@map("communications_lues")
}

model Evenement {
  id          String      @id @default(uuid()) @db.Uuid
  type        TypeEvenement
  title       String
  description String?
  startsAt    DateTime
  endsAt      DateTime?
  mode        ModeEvenement   @default(ONSITE)
  location    String?
  regionId    String?     @db.Uuid @map("region_id")
  status      StatutEvenement @default(PLANNED)
  archivedAt  DateTime?
  createdById String?     @db.Uuid @map("cree_par_id")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  region      Region?     @relation(fields: [regionId], references: [id])
  organizationId String?             @db.Uuid @map("organisation_id") // OPH auteur ; vide = publié par le personnel CAPH-CI
  reviewStatus   ContentReviewStatus @default(APPROVED)
  reviewedAt     DateTime?
  reviewedById   String?             @db.Uuid @map("valide_par_id")
  reviewNote     String? // motif en cas de refus
  isDemo         Boolean             @default(false) // donnée de démonstration (jamais en production)
  organization   Organization?       @relation(fields: [organizationId], references: [id])

  @@index([organizationId, reviewStatus])
  @@index([startsAt])
  @@index([type])
  @@map("evenements")
}

model Rapport {
  id                   String             @id @default(uuid()) @db.Uuid
  organizationId       String             @db.Uuid @map("organisation_id")
  authorId             String             @db.Uuid @map("auteur_id")
  type                 TypeRapport
  periodStart          DateTime?
  periodEnd            DateTime?
  title                String
  summary              String // 600 caractères maximum (contrôlé par le DTO)
  status               StatutRapport       @default(RECEIVED)
  certifiedAuthorityAt DateTime // attestation d'habilitation à transmettre
  reviewerNote         String?
  reviewedById         String?            @db.Uuid @map("valide_par_id")
  submittedAt          DateTime           @default(now())
  processedAt          DateTime?
  updatedAt            DateTime           @updatedAt
  organization         Organization       @relation(fields: [organizationId], references: [id])
  author               User               @relation("RapportAuthor", fields: [authorId], references: [id])
  reviewedBy           User?              @relation("RapportReviewer", fields: [reviewedById], references: [id])
  isDemo               Boolean            @default(false) // donnée de démonstration
  attachments          RapportPieceJointe[]

  @@index([organizationId, submittedAt])
  @@index([status])
  @@map("rapports")
}

model RapportPieceJointe {
  id        String    @id @default(uuid()) @db.Uuid
  rapportId  String    @db.Uuid @map("rapport_id")
  fileId    String    @db.Uuid @map("fichier_id")
  createdAt DateTime  @default(now())
  rapport    Rapport    @relation(fields: [rapportId], references: [id], onDelete: Cascade)
  file      FileAsset @relation(fields: [fileId], references: [id])

  @@index([rapportId])
  @@map("rapports_pieces_jointes")
}

model NewsProposal {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid @map("organisation_id")
  authorId       String              @db.Uuid @map("auteur_id")
  categoryId     String?             @db.Uuid @map("categorie_id")
  title          String
  summary        String? // résumé court
  description    String // contenu complet
  newsDate       DateTime? // date de l'événement ou de l'actualité
  coverFileId    String?             @db.Uuid @map("fichier_couverture_id")
  status         NewsStatus          @default(DRAFT)
  reviewerNote   String?
  reviewedById   String?            @db.Uuid @map("valide_par_id")
  createdAt      DateTime            @default(now())
  submittedAt    DateTime? // renseignée à la soumission (null pour un brouillon)
  reviewedAt     DateTime?
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id])
  category       NewsCategory?       @relation(fields: [categoryId], references: [id])
  author         User                @relation("NewsAuthor", fields: [authorId], references: [id])
  reviewedBy     User?               @relation("NewsReviewer", fields: [reviewedById], references: [id])
  isDemo         Boolean             @default(false) // donnée de démonstration
  cover          FileAsset?          @relation("NewsCover", fields: [coverFileId], references: [id])
  attachments    NewsAttachment[]
  history        NewsStatusHistory[]

  @@index([organizationId, updatedAt])
  @@index([status])
  @@map("actualites")
}

/// Historique des décisions : une ligne à chaque changement de statut (jamais modifiée).
model NewsStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  proposalId String       @db.Uuid @map("actualite_id")
  fromStatus NewsStatus?
  toStatus   NewsStatus
  note       String?
  actorId    String?      @db.Uuid @map("acteur_id")
  createdAt  DateTime     @default(now())
  proposal   NewsProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
  @@map("actualites_historique")
}

model NewsAttachment {
  id         String       @id @default(uuid()) @db.Uuid
  proposalId String       @db.Uuid @map("actualite_id")
  fileId     String       @db.Uuid @map("fichier_id")
  createdAt  DateTime     @default(now())
  proposal   NewsProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  file       FileAsset    @relation(fields: [fileId], references: [id])

  @@index([proposalId])
  @@map("actualites_pieces_jointes")
}

/// Projet proposé par une OPH. Validé par le personnel ; seul le personnel le passe « en cours » puis « terminé ».
model Project {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid @map("organisation_id")
  authorId        String          @db.Uuid @map("auteur_id")
  title           String
  context         String? // contexte et justification
  objectives      String?
  description     String
  beneficiaries   String?
  zone            String? // zone d'intervention
  startDate       DateTime?
  endDate         DateTime? // fin prévisionnelle
  budgetXof       Int? // budget estimatif en F CFA
  partners        String?
  expectedResults String?
  coverFileId     String?         @db.Uuid @map("fichier_couverture_id")
  status          ProjectStatus   @default(DRAFT)
  reviewerNote    String?
  reviewedById    String?         @db.Uuid @map("valide_par_id")
  progress        Int? // % d'avancement : renseigné par le personnel uniquement, jamais calculé ni inventé
  results         String? // résultats / réalisations constatés, renseignés par le personnel
  createdAt       DateTime        @default(now())
  submittedAt     DateTime?
  reviewedAt      DateTime?
  updatedAt       DateTime        @updatedAt
  organization    Organization    @relation(fields: [organizationId], references: [id])
  author          User            @relation("ProjectAuthor", fields: [authorId], references: [id])
  reviewedBy      User?           @relation("ProjectReviewer", fields: [reviewedById], references: [id])
  isDemo          Boolean         @default(false) // donnée de démonstration
  cover           FileAsset?      @relation("ProjectCover", fields: [coverFileId], references: [id])
  attachments     ProjectAttachment[]
  history         ProjectStatusHistory[]

  @@index([organizationId, updatedAt])
  @@index([status])
  @@map("projets")
}

model ProjectAttachment {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @db.Uuid @map("projet_id")
  fileId    String   @db.Uuid @map("fichier_id")
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  file      FileAsset @relation(fields: [fileId], references: [id])

  @@index([projectId])
  @@map("projets_pieces_jointes")
}

/// Historique des décisions : une ligne à chaque changement de statut (jamais modifiée).
model ProjectStatusHistory {
  id         String         @id @default(uuid()) @db.Uuid
  projectId  String         @db.Uuid @map("projet_id")
  fromStatus ProjectStatus?
  toStatus   ProjectStatus
  note       String?
  actorId    String?        @db.Uuid @map("acteur_id")
  createdAt  DateTime       @default(now())
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("projets_historique")
}

// ─────────────────────────────────── AUDIT ────────────────────────────────

// Append-only. Aucune donnée sensible (mot de passe, contenu de pièce) dans metadata.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actorLabel String? // e-mail ou "anonyme" (ex. échec de connexion)
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
