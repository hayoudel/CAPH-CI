# ── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# URL du frontend (liens dans les e-mails) et origines autorisées par CORS (séparées par des virgules)
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Nombre de relais devant l'API (nginx, hébergeur…). 0 en local ; 1 en production derrière un seul relais.
TRUST_PROXY=0
SWAGGER_ENABLED=true

# ── Base de données ─────────────────────────────────────────
DATABASE_URL="postgresql://caphci:caphci_dev_password@localhost:5433/caphci_oph?schema=public"

# ── Sécurité (OBLIGATOIRE : générer des valeurs uniques) ────
# openssl rand -base64 48
JWT_ACCESS_SECRET=remplacer-par-une-valeur-aleatoire-de-48-caracteres-minimum
JWT_REFRESH_SECRET=remplacer-par-une-autre-valeur-aleatoire-de-48-caracteres
JWT_ACCESS_TTL=15m
# openssl rand -base64 32  (chiffrement des pièces d'identité)
FILES_ENCRYPTION_KEY=

# ── Stockage privé des fichiers (hors dossier public) ───────
STORAGE_DIR=./storage

# ── E-mail (laisser MAIL_HOST vide = les e-mails sont affichés dans la console) ──
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="CAPH-CI <no-reply@caphci.org>"

# ── Notifications internes ──────────────────────────────────
# Adresse qui reçoit un message à chaque nouveau dossier d'adhésion (laisser vide = aucune notification)
MEMBERSHIP_NOTIFY_EMAIL=

# ── Données de démarrage (seed) ─────────────────────────────
SEED_ADMIN_EMAIL=admin@caphci.local
SEED_ADMIN_PASSWORD=
# true = ajoute des données d'exemple (OPH fictive, régions, délégations). Jamais en production.
SEED_DEMO=true
